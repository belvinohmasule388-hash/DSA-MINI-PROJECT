PART E — Pseudocode and Algorithm Representation

1. Queue Operations
METHOD enqueue(student):
    newNode = NEW Node(student)
    IF front == null THEN
        front = newNode
        rear = newNode
    ELSE
        rear.next = newNode
        rear = newNode
    END IF
END METHOD

METHOD dequeue():
    IF front == null THEN
        RETURN null
    END IF
    servedStudent = front.data
    front = front.next
    IF front == null THEN
        rear = null
    END IF
    RETURN servedStudent
END METHOD

2. Stack & Postfix Evaluation
METHOD push(val):
    newNode = NEW Node(val)
    newNode.next = top
    top = newNode
END METHOD

METHOD pop():
    IF top == null THEN RETURN null
    val = top.data
    top = top.next
    RETURN val
END METHOD

METHOD evaluatePostfix(expression):
    FOR EACH token IN expression DO
        IF token IS NUMBER THEN
            push(token)
        ELSE IF token IS OPERATOR THEN
            val2 = pop()
            val1 = pop()
            result = APPLY operator(val1, val2)
            push(result)
        END IF
    END FOR
    RETURN pop()
END METHOD
3. Singly Linked List Operations
METHOD insertNode(student):
    newNode = NEW Node(student)
    IF head == null THEN
        head = newNode
    ELSE
        temp = head
        WHILE temp.next != null DO
            temp = temp.next
        END WHILE
        temp.next = newNode
    END IF
END METHOD

METHOD deleteNode(studentNo):
    IF head == null THEN RETURN false
    IF head.data.studentNo == studentNo THEN
        head = head.next
        RETURN true
    END IF
    temp = head
    WHILE temp.next != null DO
        IF temp.next.data.studentNo == studentNo THEN
            temp.next = temp.next.next
            RETURN true
        END IF
        temp = temp.next
    END WHILE
    RETURN false
END METHOD

METHOD searchNode(studentNo):
    temp = head
    WHILE temp != null DO
        IF temp.data.studentNo == studentNo THEN
            RETURN temp.data
        END IF
        temp = temp.next
    END WHILE
    RETURN null
END METHOD

METHOD traverseList():
    temp = head
    WHILE temp != null DO
        PRINT temp.data
        temp = temp.next
    END WHILE
END METHOD
4. Sorting Algorithms
METHOD selectionSort(arr):
    n = LENGTH(arr)
    FOR i = 0 TO n - 2 DO
        minIndex = i
        FOR j = i + 1 TO n - 1 DO
            IF arr[j] < arr[minIndex] THEN
                minIndex = j
            END IF
        END FOR
        SWAP arr[i] WITH arr[minIndex]
    END FOR
END METHOD

METHOD insertionSort(arr):
    n = LENGTH(arr)
    FOR i = 1 TO n - 1 DO
        key = arr[i]
        j = i - 1
        WHILE j >= 0 AND arr[j] > key DO
            arr[j + 1] = arr[j]
            j = j - 1
        END WHILE
        arr[j + 1] = key
    END FOR
END METHOD

METHOD mergeSort(arr, left, right):
    IF left < right THEN
        mid = (left + right) / 2
        mergeSort(arr, left, mid)
        mergeSort(arr, mid + 1, right)
        merge(arr, left, mid, right)
    END IF
END METHOD

METHOD quickSort(arr, low, high):
    IF low < high THEN
        pivotIndex = partition(arr, low, high)
        quickSort(arr, low, pivotIndex - 1)
        quickSort(arr, pivotIndex + 1, high)
    END IF
END METHOD
 
