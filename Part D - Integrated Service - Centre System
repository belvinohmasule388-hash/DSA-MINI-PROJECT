PART D — Integrated Service-Centre System

import java.util.Scanner;
import java.util.Random;

public class CampusServiceCentre {
    static class Student {
        String studentNo;
        String name;
        String serviceType;
        int estimatedTime; 
        
        Student(String studentNo, String name, String serviceType, int estimatedTime) {
            this.studentNo = studentNo;
            this.name = name;
            this.serviceType = serviceType;
            this.estimatedTime = estimatedTime;
        }

        void printInfo() {
            System.out.println("[" + studentNo + "] " + name + " | Service: " + serviceType + " | Time: " + estimatedTime + " mins");
        }
    }

    // ================================
    // PART 1: THE QUEUE (waiting line)
    // ================================

    static class Node {
        Student student;
        Node next; 

        Node(Student student) {
            this.student = student;
            this.next = null;
        }
    }

    static class StudentQueue {
        Node front; 
        Node rear;  
        
        void enqueue(Student student) {
            Node newNode = new Node(student);

            if (front == null) {
                front = newNode;
                rear = newNode;
            } else {
              
                rear.next = newNode;
                rear = newNode;
            }
            System.out.println(student.name + " added to waiting queue.");
        }
        
        Student dequeue() {
            if (front == null) {
                System.out.println("Queue is empty!");
                return null;
            }

            Student servedStudent = front.student;
            front = front.next; 

            if (front == null) {
                rear = null;
            }

            return servedStudent;
        }
        
        void displayQueue() {
            if (front == null) {
                System.out.println("Queue is currently empty.");
                return;
            }

            System.out.println("\n--- Current Waiting Queue ---");
            Node current = front;
            int position = 1;

            while (current != null) {
                System.out.print(position + ". ");
                current.student.printInfo();
                current = current.next;
                position++;
            }
        }
    }

    // =========================================
    // PART 2: THE LINKED LIST (served students)
    // =========================================
    static class ListNode {
        Student student;
        ListNode next;

        ListNode(Student student) {
            this.student = student;
            this.next = null;
        }
    }

    static class StudentLinkedList {
        ListNode head; 
        void insertStudent(Student student) {
            ListNode newNode = new ListNode(student);

            if (head == null) {
                head = newNode;
            } else {
                ListNode current = head;
                while (current.next != null) {
                    current = current.next;
                }
                current.next = newNode;
            }
            System.out.println("Record added for " + student.name);
        }
        
        void displayStudents() {
            if (head == null) {
                System.out.println("No records found.");
                return;
            }

            System.out.println("\n--- Student Service Records ---");
            ListNode current = head;
            while (current != null) {
                current.student.printInfo();
                current = current.next;
            }
        }

        Student searchStudent(String studentNo) {
            ListNode current = head;
            while (current != null) {
                if (current.student.studentNo.equals(studentNo)) {
                    return current.student;
                }
                current = current.next;
            }
            return null; 
        }
        boolean removeStudent(String studentNo) {
            if (head == null) {
                return false;
            }

            if (head.student.studentNo.equals(studentNo)) {
                head = head.next;
                return true;
            }

            ListNode current = head;
            while (current.next != null) {
                if (current.next.student.studentNo.equals(studentNo)) {
                    current.next = current.next.next;
                    return true;
                }
                current = current.next;
            }
            return false; 
        }
    }

    // ==================================
    // PART 3: MAIN PROGRAM AND MENU
    // ==================================
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        StudentQueue queue = new StudentQueue();
        StudentLinkedList records = new StudentLinkedList();

        int[] serviceTimes = new int[100];
        int servedCount = 0; 
        
        queue.enqueue(new Student("221045678", "Maria", "Registration", 12));
        queue.enqueue(new Student("222034512", "Tomas", "Student Card", 5));
        queue.enqueue(new Student("223041876", "Ndapewa", "Fees", 8));
        queue.enqueue(new Student("221067341", "Simon", "Documents", 4));

        int choice = 0;

        while (choice != 11) {
            System.out.println("\n==================================");
            System.out.println("    CAMPUS SERVICE CENTRE MENU    ");
            System.out.println("==================================");
            System.out.println("1. Add student to waiting queue");
            System.out.println("2. Serve next student (remove from queue)");
            System.out.println("3. Display waiting students");
            System.out.println("4. Add student service record (Linked List)");
            System.out.println("5. Display student service records");
            System.out.println("6. Search for student record");
            System.out.println("7. Remove student record");
            System.out.println("8. Display daily statistics");
            System.out.println("9. Sort service times");
            System.out.println("10. Run sorting experiment");
            System.out.println("11. Exit");
            System.out.print("Select option: ");

            choice = scanner.nextInt();
            scanner.nextLine();

            if (choice == 1) {
                System.out.print("Enter Student No: ");
                String id = scanner.nextLine();
                System.out.print("Enter Name: ");
                String name = scanner.nextLine();
                System.out.print("Enter Service Type: ");
                String type = scanner.nextLine();
                System.out.print("Enter Estimated Time (min): ");
                int time = scanner.nextInt();

                queue.enqueue(new Student(id, name, type, time));

            } else if (choice == 2) {
                Student servedStudent = queue.dequeue();
                if (servedStudent != null) {
                    System.out.println("Now serving: " + servedStudent.name);
                    records.insertStudent(servedStudent);
                    serviceTimes[servedCount] = servedStudent.estimatedTime;
                    servedCount++;
                }

            } else if (choice == 3) {
                queue.displayQueue();

            } else if (choice == 4) {
                System.out.print("Enter Student No: ");
                String id = scanner.nextLine();
                System.out.print("Enter Name: ");
                String name = scanner.nextLine();
                System.out.print("Enter Service Type: ");
                String type = scanner.nextLine();
                System.out.print("Enter Estimated Time (min): ");
                int time = scanner.nextInt();

                records.insertStudent(new Student(id, name, type, time));

            } else if (choice == 5) {
                records.displayStudents();

            } else if (choice == 6) {
                System.out.print("Enter Student No to search: ");
                String id = scanner.nextLine();
                Student foundStudent = records.searchStudent(id);
                if (foundStudent != null) {
                    foundStudent.printInfo();
                } else {
                    System.out.println("Record not found!");
                }

            } else if (choice == 7) {
                System.out.print("Enter Student No to remove: ");
                String id = scanner.nextLine();
                if (records.removeStudent(id)) {
                    System.out.println("Record deleted successfully.");
                } else {
                    System.out.println("Record not found!");
                }

            } else if (choice == 8) {
                if (servedCount == 0) {
                    System.out.println("No students served yet today!");
                } else {
                    int total = 0;
                    int highest = serviceTimes[0];
                    int lowest = serviceTimes[0];
                    int over10 = 0;

                    for (int i = 0; i < servedCount; i++) {
                        int t = serviceTimes[i];
                        total = total + t;

                        if (t > highest) {
                            highest = t;
                        }
                        if (t < lowest) {
                            lowest = t;
                        }
                        if (t > 10) {
                            over10 = over10 + 1;
                        }
                    }

                    double average = (double) total / servedCount;

                    System.out.println("\n--- DAILY STATISTICS ---");
                    System.out.println("Total Students Served: " + servedCount);
                    System.out.println("Total Service Time: " + total + " mins");
                    System.out.println("Average Service Time: " + average + " mins");
                    System.out.println("Highest Service Time: " + highest + " mins");
                    System.out.println("Lowest Service Time: " + lowest + " mins");
                    System.out.println("Services > 10 mins: " + over10);
                }

            } else if (choice == 9) {
                
                int[] testArray = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};

                System.out.print("\nUnsorted Array: ");
                for (int i = 0; i < testArray.length; i++) {
                    System.out.print(testArray[i] + " ");
                }

                
                for (int i = 0; i < testArray.length - 1; i++) {
                    int smallestIndex = i;

                    for (int j = i + 1; j < testArray.length; j++) {
                        if (testArray[j] < testArray[smallestIndex]) {
                            smallestIndex = j;
                        }
                    }

                    
                    int temp = testArray[i];
                    testArray[i] = testArray[smallestIndex];
                    testArray[smallestIndex] = temp;
                }

                System.out.print("\nSorted Array: ");
                for (int i = 0; i < testArray.length; i++) {
                    System.out.print(testArray[i] + " ");
                }
                System.out.println();

            } else if (choice == 10) {
                System.out.println("\nRunning Part C Experiments on sizes 20, 50, 100, 500...");
                runExperiment();

            } else if (choice == 11) {
                System.out.println("Exiting System. Goodbye!");

            } else {
                System.out.println("Invalid option! Try again.");
            }
        }
    }


    public static void runExperiment() {
        int[] sizes = {20, 50, 100, 500};
        Random rand = new Random();

        for (int size : sizes) {
            int[] original = new int[size];
            for (int i = 0; i < size; i++) {
                original[i] = rand.nextInt(1000);
            }

        
            int[] copy = original.clone();

            long startTime = System.nanoTime();
            int comparisons = 0;

            for (int i = 0; i < copy.length - 1; i++) {
                int smallestIndex = i;
                for (int j = i + 1; j < copy.length; j++) {
                    comparisons++;
                    if (copy[j] < copy[smallestIndex]) {
                        smallestIndex = j;
                    }
                }
                int temp = copy[i];
                copy[i] = copy[smallestIndex];
                copy[smallestIndex] = temp;
            }

            long endTime = System.nanoTime();

            System.out.println("Size " + size + " | Selection Sort | Comparisons: " + comparisons + " | Time: " + (endTime - startTime) + " ns");
        }
    }
}
