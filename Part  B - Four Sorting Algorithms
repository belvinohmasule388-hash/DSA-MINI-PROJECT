Task B1 — Selection Sort
Array: [17, 5, 23, 8, 14, 3, 11, 20, 6, 9]
Selection sort repeatedly finds the smallest remaining number in the unsorted portion and swaps it with the first unsorted position. 
Pass Traces (First 3 Passes)
•	Initial Array: [17, 5, 23, 8, 14, 3, 11, 20, 6, 9]
  •	Pass 1:
    o	Smallest value found: 3 (index 5). 
    o	Swap 3 with 17 (index 0). 
    o Array after Pass 1: [3, 5, 23, 8, 14, 17, 11, 20, 6, 9]
  •	Pass 2:
    o	Smallest value from index 1 onward: 5 (index 1). 
    o	5 is already in place. Swap 5 with 5 (no change).
    o	Array after Pass 2: [3, 5, 23, 8, 14, 17, 11, 20, 6, 9]
  •	Pass 3:
    o	Smallest value from index 2 onward: 6 (index 8). 
    o	Swap 6 with 23 (index 2). 
    o	Array after Pass 3: [3, 5, 6, 8, 14, 17, 11, 20, 23, 9] 

 Task B1 Java Implementation
public class SelectionSort {

    public static void selectionSort(int[] arr) {
        int comparisons = 0;
        int swaps = 0;
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            int minIndex = i;

            // Search for the smallest element in unsorted part
            for (int j = i + 1; j < n; j++) {
                comparisons++;
                if (arr[j] < arr[minIndex]) {
                    minIndex = j;
                }
            }

            // Swap the found minimum element with element at index i
            if (minIndex != i) {
                int temp = arr[i];
                arr[i] = arr[minIndex];
                arr[minIndex] = temp;
                swaps++;
            }

            // Print first 3 passes
            if (i < 3) {
                System.out.print("Pass " + (i + 1) + ": ");
                printArray(arr);
            }
        }

        System.out.println("Total Comparisons: " + comparisons);
        System.out.println("Total Swaps: " + swaps);
    }

    public static void printArray(int[] arr) {
        for (int num : arr) {
            System.out.print(num + " ");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        int[] data = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};
        System.out.println("=== SELECTION SORT ===");
        selectionSort(data);
    }
}

Task B2 — Insertion Sort [5]
import java.util.Arrays;

public class InsertionSortDemo {

    static long comparisons = 0;
    static long shifts = 0;

    public static void main(String[] args) {
        int[] serviceTimes = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};

        System.out.println("Before sorting: " + Arrays.toString(serviceTimes));
        System.out.println();

        insertionSort(serviceTimes, 3); // show first 3 passes

        System.out.println();
        System.out.println("After sorting: " + Arrays.toString(serviceTimes));
        System.out.println("Total comparisons: " + comparisons);
        System.out.println("Total shifts: " + shifts);
    }

    // Sorts the array in place using insertion sort.
    // passesToShow controls how many early passes get printed (for the report).
    public static void insertionSort(int[] arr, int passesToShow) {
        comparisons = 0;
        shifts = 0;

        for (int i = 1; i < arr.length; i++) {
            int key = arr[i];
            int j = i - 1;

            while (j >= 0) {
                comparisons++; // comparing arr[j] with key
                if (arr[j] > key) {
                    arr[j + 1] = arr[j];
                    shifts++;
                    j--;
                } else {
                    break;
                }
            }
            arr[j + 1] = key;

            if (i <= passesToShow) {
                System.out.println("After pass " + i + ": " + Arrays.toString(arr));
            }
        }
    }
}

Task B3 — Merge Sort 

import java.util.Arrays;

public class MergeSortDemo {

    static long comparisons = 0;

    public static void main(String[] args) {
        int[] serviceTimes = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};

        System.out.println("Before sorting: " + Arrays.toString(serviceTimes));

        mergeSort(serviceTimes, 0, serviceTimes.length - 1);

        System.out.println("After sorting: " + Arrays.toString(serviceTimes));
        System.out.println("Total comparisons: " + comparisons);
    }

   
    public static void mergeSort(int[] arr, int left, int right) {
        if (left >= right) {
            return; // base case: 0 or 1 element, already sorted on its own
        }
        int mid = left + (right - left) / 2;

        mergeSort(arr, left, mid);       // sort left half
        mergeSort(arr, mid + 1, right);  // sort right half
        merge(arr, left, mid, right);    // merge the two sorted halves
    }

    
    public static void merge(int[] arr, int left, int mid, int right) {
        int[] leftArr = Arrays.copyOfRange(arr, left, mid + 1);
        int[] rightArr = Arrays.copyOfRange(arr, mid + 1, right + 1);

        int i = 0, j = 0, k = left;

        while (i < leftArr.length && j < rightArr.length) {
            comparisons++; // comparing leftArr[i] with rightArr[j]
            if (leftArr[i] <= rightArr[j]) {
                arr[k] = leftArr[i];
                i++;
            } else {
                arr[k] = rightArr[j];
                j++;
            }
            k++;
        }

       
        while (i < leftArr.length) {
            arr[k] = leftArr[i];
            i++;
            k++;
        }
        while (j < rightArr.length) {
            arr[k] = rightArr[j];
            j++;
            k++;
        }
    }
}

Task B4 — Quick Sort 
public class QuickSort {

    static long comparisons = 0; // counts data-value comparisons

    public static void main(String[] args) {
        int[] numbers = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};

        System.out.println("Before sorting:");
        printArray(numbers);

        quickSort(numbers, 0, numbers.length - 1);

        System.out.println("\nAfter sorting:");
        printArray(numbers);

        System.out.println("\nTotal comparisons: " + comparisons);
    }

    // Recursively sorts the array between low and high
    public static void quickSort(int[] arr, int low, int high) {
        if (low < high) {
            int pivotIndex = partition(arr, low, high);
            quickSort(arr, low, pivotIndex - 1);
            quickSort(arr, pivotIndex + 1, high);
        }
    }
    // Places the pivot (last element) in its correct sorted position
    // and puts smaller values to its left, bigger values to its right
    public static int partition(int[] arr, int low, int high) {
        int pivot = arr[high];
        int i = low - 1; // boundary for values smaller than pivot

        for (int j = low; j < high; j++) {
            comparisons++; // comparing arr[j] with pivot
            if (arr[j] < pivot) {
                i++;
                swap(arr, i, j);
            }
        }
        swap(arr, i + 1, high); // put pivot in its final position
        return i + 1;
    }

    public static void swap(int[] arr, int a, int b) {
        int temp = arr[a];
        arr[a] = arr[b];
        arr[b] = temp;
    }
    public static void printArray(int[] arr) {
        for (int num : arr) {
            System.out.print(num + " ");
        }
        System.out.println();
    }
}   
