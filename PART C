import java.util.Random;
import java.util.Arrays;
//SortingExperiment
public class Main {

    static long comparisons = 0; // shared counter, reset before each sort

    public static void main(String[] args) {
        runFullExperiment();
    }

    // Generates an array of random numbers between 1 and bound
    public static int[] generateArray(int size, int bound) {
        Random rand = new Random(42); // fixed seed so results are repeatable
        int[] arr = new int[size];
        for (int i = 0; i < size; i++) {
            arr[i] = rand.nextInt(bound) + 1;
        }
        return arr;
    }

    public static int[] copyArray(int[] arr) {
        return Arrays.copyOf(arr, arr.length);
    }

    // ---------- SELECTION SORT ----------
    public static void selectionSort(int[] arr) {
        comparisons = 0;
        for (int i = 0; i < arr.length - 1; i++) {
            int minIndex = i;
            for (int j = i + 1; j < arr.length; j++) {
                comparisons++;
                if (arr[j] < arr[minIndex]) {
                    minIndex = j;
                }
            }
            int temp = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = temp;
        }
    }

    // ---------- INSERTION SORT ----------
    public static void insertionSort(int[] arr) {
        comparisons = 0;
        for (int i = 1; i < arr.length; i++) {
            int key = arr[i];
            int j = i - 1;
            while (j >= 0) {
                comparisons++;
                if (arr[j] > key) {
                    arr[j + 1] = arr[j];
                    j--;
                } else {
                    break;
                }
            }
            arr[j + 1] = key;
        }
    }

    // ---------- MERGE SORT ----------
    public static void mergeSort(int[] arr) {
        comparisons = 0;
        int[] temp = new int[arr.length];
        mergeSortHelper(arr, temp, 0, arr.length - 1);
    }

    private static void mergeSortHelper(int[] arr, int[] temp, int left, int right) {
        if (left < right) {
            int mid = (left + right) / 2;
            mergeSortHelper(arr, temp, left, mid);
            mergeSortHelper(arr, temp, mid + 1, right);
            merge(arr, temp, left, mid, right);
        }
    }

    private static void merge(int[] arr, int[] temp, int left, int mid, int right) {
        for (int i = left; i <= right; i++) {
            temp[i] = arr[i];
        }
        int i = left, j = mid + 1, k = left;
        while (i <= mid && j <= right) {
            comparisons++;
            if (temp[i] <= temp[j]) {
                arr[k] = temp[i];
                i++;
            } else {
                arr[k] = temp[j];
                j++;
            }
            k++;
        }
        while (i <= mid) {
            arr[k] = temp[i];
            i++;
            k++;
        }
        while (j <= right) {
            arr[k] = temp[j];
            j++;
            k++;
        }
    }

    // ---------- QUICK SORT ----------
    public static void quickSort(int[] arr) {
        comparisons = 0;
        quickSortHelper(arr, 0, arr.length - 1);
    }

    private static void quickSortHelper(int[] arr, int low, int high) {
        if (low < high) {
            int pivotIndex = partition(arr, low, high);
            quickSortHelper(arr, low, pivotIndex - 1);
            quickSortHelper(arr, pivotIndex + 1, high);
        }
    }

    private static int partition(int[] arr, int low, int high) {
        int pivot = arr[high];
        int i = low - 1;
        for (int j = low; j < high; j++) {
            comparisons++;
            if (arr[j] < pivot) {
                i++;
                swap(arr, i, j);
            }
        }
        swap(arr, i + 1, high);
        return i + 1;
    }

    private static void swap(int[] arr, int a, int b) {
        int temp = arr[a];
        arr[a] = arr[b];
        arr[b] = temp;
    }

    // ---------- ALMOST SORTED ARRAY ----------
    // Sorts ascending then swaps 5 neighbouring pairs
    public static int[] makeAlmostSorted(int[] sortedArr) {
        int[] a = copyArray(sortedArr);
        int[][] pairs = {{0, 1}, {20, 21}, {40, 41}, {60, 61}, {80, 81}};
        for (int[] p : pairs) {
            if (p[1] < a.length) {
                int temp = a[p[0]];
                a[p[0]] = a[p[1]];
                a[p[1]] = temp;
            }
        }
        return a;
    }

    // ---------- RUNNING THE EXPERIMENT ----------
    public static void runFullExperiment() {
        int[] sizes = {20, 50, 100, 500};
        System.out.printf("%-15s %-10s %-15s %-15s%n", "Algorithm", "Size", "Comparisons", "Time(ns)");
        System.out.println("---------------------------------------------------------------");

        for (int size : sizes) {
            int[] original = generateArray(size, 1000);
            testOne("Selection Sort", original, 1);
            testOne("Insertion Sort", original, 2);
            testOne("Merge Sort", original, 3);
            testOne("Quick Sort", original, 4);
        }

        // Almost-sorted test on 100 elements
        System.out.println("\nAlmost-sorted test (100 elements, 5 pairs swapped):");
        int[] base = generateArray(100, 1000);
        int[] sortedCopy = copyArray(base);
        mergeSort(sortedCopy); // get an ascending version using our own sort
        int[] almost = makeAlmostSorted(sortedCopy);

        testOne("Selection Sort", almost, 1);
        testOne("Insertion Sort", almost, 2);
        testOne("Merge Sort", almost, 3);
        testOne("Quick Sort", almost, 4);
    }

    // Runs one sort, times it, prints the result row
    private static void testOne(String label, int[] original, int whichSort) {
        int[] copy = copyArray(original);
        long start = System.nanoTime();

        if (whichSort == 1) selectionSort(copy);
        else if (whichSort == 2) insertionSort(copy);
        else if (whichSort == 3) mergeSort(copy);
        else quickSort(copy);
        long end = System.nanoTime();
        System.out.printf("%-15s %-10d %-15d %-15d%n", label, original.length, comparisons, (end - start));
    }
}
