Before serving: front -> [Maria] -> [Tomas] -> [Ndapewa] -> [Simon] -> [Anna] -> [Petrus] <- rear 
After serving 3 (Maria, Tomas, Ndapewa dequeued): front -> [Simon] -> [Anna] -> [Petrus] <- rear

class Main {
    public static void main(String[] args) {
        StudentQueue queue = new StudentQueue();
 
        System.out.println(" Arrival of six students ");
        queue.enqueue(new Student("221045678", "Maria", "Registration", 12));
        queue.enqueue(new Student("222034512", "Tomas", "Student Card", 5));
        queue.enqueue(new Student("223041876", "Ndapewa", "Fees", 8));
        queue.enqueue(new Student("221067341", "Simon", "Documents", 4));
        queue.enqueue(new Student("222099001", "Themba", "Enquiry", 6));
        queue.enqueue(new Student("223012345", "Masule", "Fees", 9));
 
        System.out.println("\nQueue right after all 6 arrivals:");
        
        queue.displayQueue();
        System.out.println("\n 3 Stuents served ");
        for (int i = 1; i <= 3; i++) {
            Student served = queue.dequeue();
            System.out.println("Student served" + i + ": " + served);
        }
        System.out.println("\nQueue after serving 3 students:");
        queue.displayQueue();
 
        System.out.println("\n peek ");
        System.out.println("peek() -> next in line: " + queue.peek());
        System.out.println("isEmpty() -> " + queue.isEmpty());
    }
}
 
class StudentQueue {
    private Node front;
    private Node rear;
    private int size;
 
    private class Node {
        Student data;
        Node next;
        Node(Student data) {
            this.data = data;
            this.next = null;
        }
    }
 
    public StudentQueue() {
        front = null;
        rear = null;
        size = 0;
    }
 
    
    public void enqueue(Student student) {
        Node newNode = new Node(student);
        if (front == null) {
            front = newNode;
            rear = newNode;
        } else {
            rear.next = newNode;
            rear = newNode;
        }
        size = size + 1;
    }
 
   
    public Student dequeue() {
        if (isEmpty()) {
            System.out.println("Queue is empty. Cannot dequeue.");
            return null;
        }
        Student served = front.data;
        front = front.next;
        if (front == null) {   // queue became empty, so rear must reset too
            rear = null;
        }
        size = size - 1;
        return served;
    }
 
   
    public Student peek() {
        if (isEmpty()) {
            System.out.println("Queue is empty. Nothing to peek.");
            return null;
        }
        return front.data;
    }
 
    public boolean isEmpty() {
        return front == null;
    }
 
   
    public void displayQueue() {
        if (isEmpty()) {
            System.out.println("[Queue is empty]");
            return;
        }
        Node current = front;
        int i = 1;
        while (current != null) {
            System.out.println(i + ". " + current.data);
            current = current.next;
            i++;
        }
    }
}
 
class Student {
    String studentNumber;
    String name;
    String serviceType;
    int estimatedServiceTime;
 
    Student(String studentNumber, String name, String serviceType, int estimatedServiceTime) {
        this.studentNumber = studentNumber;
        this.name = name;
        this.serviceType = serviceType;
        this.estimatedServiceTime = estimatedServiceTime;
    }
 
    public String toString() {
        return studentNumber + " " + name + " (" + serviceType + ", " + estimatedServiceTime + " min)";
    }
}



The reason as to why queue is the appropriate approach 
is because students must be served strictly in arrival order so queue (FIRST IN FIRST OUT) is used to model the waiting line, 
and because it defines operations insert at the rear the front. 
